@page
@model PowerSentinel.Pages.Admin.Events.DeleteModel

<h2>Delete Event</h2>
<div>
    <p>Are you sure you want to delete event '@Model.Event?.Id'?</p>
    <form method="post" class="flex items-center gap-3">
        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white rounded px-4 py-1">Yes, delete</button>
        <a asp-page="Index" class="bg-gray-200 hover:bg-gray-300 text-gray-800 rounded px-4 py-1">Cancel</a>
    </form>
</div>
