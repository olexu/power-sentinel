@page
@model PowerSentinel.Pages.EventsModel

<a href="/Statistic?deviceId=@Model.DeviceId">
@await Html.PartialAsync("_DeviceInfo", @Model.DeviceInfo)
</a>

<div class="space-y-2 mt-2">
  <header class="flex items-center justify-between">
    <div>
      <h2 class="text-xl font-semibold text-slate-800 dark:text-slate-200">@Model.FilterDate.ToString("dd.MM.yyyy")</h2>
    </div>
    <div class="flex items-center gap-2">
      @{ 
        var prevDate = Model.FilterDate.AddDays(-1).ToString("yyyy-MM-dd");
        var nextDate = Model.FilterDate.AddDays(1).ToString("yyyy-MM-dd");
      }
      <a class="px-3 py-1 bg-white dark:bg-slate-800 dark:border-gray-700 border border-gray-200 rounded shadow-sm text-sm dark:text-slate-200"
         href="?deviceId=@Model.DeviceId&date=@prevDate">Previous</a>
      <a class="px-3 py-1 bg-white dark:bg-slate-800 dark:border-gray-700 border border-gray-200 rounded shadow-sm text-sm dark:text-slate-200"
         href="?deviceId=@Model.DeviceId&date=@nextDate">Next</a>
    </div>
  </header>

  <section class="mt-2">
    <div class="p-3 bg-white dark:bg-slate-800 border border-gray-200 dark:border-gray-700 rounded flex items-center justify-between">
      <div>
        <div class="text-xs text-slate-500">@Model.TotalOnDuration.ToDisplayString() up • @Model.TotalOffDuration.ToDisplayString() down</div>
      </div>
      <div class="w-24 sm:w-40">
          <div class="flex items-center gap-3">
            <div class="flex-1">
              <div class="h-2 bg-gray-200 dark:bg-gray-700 rounded overflow-hidden" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@((int)Math.Round(Model.UptimePercent))">
                <div class="h-2 bg-emerald-500 dark:bg-emerald-400 transition-all duration-200" style="width:@((int)Math.Round(Model.UptimePercent))%"></div>
              </div>
            </div>
            <div class="flex flex-row gap-1 text-xs text-slate-500 text-right whitespace-nowrap">
              <div class="font-semibold dark:text-slate-100">@Model.UptimePercent.ToString("F0")%</div>
              <div class="text-xs text-slate-500">up</div>
            </div>
          </div>
      </div>
    </div>
  </section>

  <section>
    <div class="overflow-x-auto bg-white dark:bg-slate-800 border border-gray-200 dark:border-gray-700 rounded">
      <table class="min-w-full text-sm">
        <thead class="bg-slate-50 dark:bg-slate-900 text-slate-600 dark:text-slate-300">
          <tr>
            <th class="px-3 py-2 text-left">Date</th>
            <th class="px-3 py-2 text-center">Event</th>
            <th class="px-3 py-2 text-right">Duration</th>
          </tr>
        </thead>
        <tbody>
            @if (Model.DisplayEvents.Count == 0)
            {
              <tr><td class="p-4 dark:text-slate-200" colspan="4">No events</td></tr>
            }
          else
          {
              foreach (var evd in Model.DisplayEvents)
                  {
                  <tr class="border-t border-gray-200 dark:border-gray-700">
                    <td class="px-3 py-2 dark:text-slate-200 text-left">@evd.DisplayDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="px-3 py-2 dark:text-slate-200 text-center">
                      @if (evd.IsPowerOn)
                      {
                        <span class="inline-flex items-center gap-1 bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 px-2 py-0.5 rounded text-xs font-medium">
                          <span class="w-2 h-2 rounded-full bg-emerald-600 dark:bg-emerald-400" aria-hidden="true"></span>
                          ON
                        </span>
                      }
                      else
                      {
                        <span class="inline-flex items-center gap-1 bg-red-100 dark:bg-red-900 text-red-800 dark:text-red-200 px-2 py-0.5 rounded text-xs font-medium">
                          <span class="w-2 h-2 rounded-full bg-red-600 dark:bg-red-400" aria-hidden="true"></span>
                          OFF
                        </span>
                      }
                    </td>
                    <td class="px-3 py-2 dark:text-slate-200 text-right">@evd.DisplayDuration.ToDisplayString()</td>                      
                  </tr>
              }
          }
        </tbody>
      </table>
    </div>
  </section>
</div>
